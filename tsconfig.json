{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@earendil-works/pi-coding-agent": ["./node_modules/@earendil-works/pi-coding-agent/dist/index.d.ts"],
      "typebox": ["./node_modules/typebox"]
    }
  },
  "include": ["extensions/**/*.ts"],
  "exclude": ["extensions/**/*.test.ts"]
}
